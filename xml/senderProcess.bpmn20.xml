<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://example.com">

  <!-- Сигнал, который будет отправляться -->
  <signal id="Signal_TriggerReceiver" name="Trigger Receiver Process" />

  <process id="senderProcess" name="Sender Process" isExecutable="true">

    <startEvent id="startEvent1" name="Start" />

    <userTask id="hrTask" 
              name="Задача HR" 
              flowable:assignee="hr" />

    <sequenceFlow id="flow1" sourceRef="startEvent1" targetRef="hrTask" />
    <sequenceFlow id="flow2" sourceRef="hrTask" targetRef="endSignal" />

    <!-- Signal End Event -->
    <endEvent id="endSignal" name="Запустить Receiver">
      <signalEventDefinition id="signalEndDef" signalRef="Signal_TriggerReceiver" />
    </endEvent>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_sender">
    <bpmndi:BPMNPlane id="BPMNPlane_sender" bpmnElement="senderProcess">
      <bpmndi:BPMNShape id="start_di" bpmnElement="startEvent1">
        <dc:Bounds x="150" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_di" bpmnElement="hrTask">
        <dc:Bounds x="250" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="endSignal">
        <dc:Bounds x="400" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="186" y="118"/>
        <di:waypoint x="250" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="350" y="118"/>
        <di:waypoint x="400" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>