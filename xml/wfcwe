          })
        })
      })
      .catch(() => undefined)

    return () => {
      cancelled = true
      viewer.destroy()
      viewerRef.current = null
    }
  }, [xmlTemplate, instanceId])

  useEffect(() => {
    const viewer = viewerRef.current
    if (!viewer) {
      return
    }
