APP_NAME=Flowable BPM Backend
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL внутри Docker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/bpmn_service

# Для MVP можно оставить true, если используешь Base.metadata.create_all()
# Если используешь Alembic, лучше поставить false
AUTO_CREATE_TABLES=true

# Flowable внутри Docker
FLOWABLE_BASE_URL=http://flowable:8080/flowable-rest
FLOWABLE_USERNAME=rest-admin
FLOWABLE_PASSWORD=test